# Claude WP Bridge Configuration
# Copy this file to .env and fill in your values
# NEVER commit the .env file — it contains secrets

# Your WordPress site URL (must be HTTPS in production)
WP_BRIDGE_URL=https://your-wordpress-site.com

# API key generated from the plugin settings page
# Found at: WordPress Admin → Settings → Claude WP Bridge
WP_BRIDGE_API_KEY=your-api-key-here
